# ============================================================
# .gitignore — Structure-Constrained ViT for Medical Imaging
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so

# ----- Virtual Environments -----
.venv/
venv/
env/
ENV/

# ----- Heavy Model Checkpoints & Large Artifacts (Excluded from Git) -----
**/checkpoints/
outputs/checkpoints/
outputs/embeddings/*.pt
outputs/embeddings/dino_embeddings.pt
outputs/outputs/
outputs/logs/
outputs/**/logs/

# General model weights & binary dumps
*.pt
*.pth
*.pkl
*.h5
*.hdf5
*.onnx

# Allow lightweight precomputed priors & results needed for web dashboard
!outputs/cache/*.pt
!outputs/results/*.pt
!outputs/feasibility/*.pt
!outputs/graph/*.pt
!outputs/experiments/*.pt

# ----- Datasets -----
/data/
/datasets/
*.csv
!requirements.txt
!outputs/experiments/*.csv

# ----- Logs & Caches -----
*.log
*.cache
.cache/
logs/
*.tfevents*
runs/

# ----- TensorBoard -----
events.out.tfevents.*

# ----- Jupyter -----
.ipynb_checkpoints/
*.ipynb

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- macOS -----
.DS_Store
.AppleDouble
.LSOverride
._*

# ----- Archives / Compressed -----
*.zip
*.tar.gz
*.tar
*.gz
*.rar

# ----- Images (generated outputs) -----
# Note: only ignoring in outputs/ (already covered above)
# Project documentation images can be committed manually if needed

# ----- Miscellaneous -----
*.resolved
pyrightconfig.json
